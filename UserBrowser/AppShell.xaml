<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UserBrowser.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:UserBrowser.Views"
    Title="UserBrowser">

    <!-- Shell resolves UsersPage from the DI container, so its ViewModel is injected. -->
    <ShellContent
        Title="Users"
        ContentTemplate="{DataTemplate views:UsersPage}"
        Route="UsersPage" />

</Shell>
