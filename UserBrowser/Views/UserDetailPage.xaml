<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UserBrowser.ViewModels"
             x:Class="UserBrowser.Views.UserDetailPage"
             x:DataType="vm:UserDetailViewModel"
             Title="{Binding User.Name}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="{Binding User.Name}" FontSize="28" FontAttributes="Bold" />
            <Label Text="{Binding User.Username, StringFormat='@{0}'}" FontSize="16" />

            <BoxView HeightRequest="1" />

            <Label Text="Email" FontAttributes="Bold" />
            <Label Text="{Binding User.Email}" />

            <Label Text="Phone" FontAttributes="Bold" />
            <Label Text="{Binding User.Phone}" />

            <Label Text="Website" FontAttributes="Bold" />
            <Label Text="{Binding User.Website}" />

            <Label Text="Company" FontAttributes="Bold" />
            <Label Text="{Binding User.CompanyName}" />

            <Label Text="City" FontAttributes="Bold" />
            <Label Text="{Binding User.City}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
