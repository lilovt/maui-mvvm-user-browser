<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UserBrowser.ViewModels"
             x:Class="UserBrowser.Views.UsersPage"
             x:DataType="vm:UsersViewModel"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False"
             Title="People">

    <!-- VIEW: layout and bindings only. x:DataType turns on compiled bindings.
         Rows: header band, search, error line, list (fills the space), footer tab bar. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- HEADER: gradient band. The two faint circles add depth; the Grid clips them to the band. -->
        <Grid x:Name="HeaderBar" Grid.Row="0" IsClippedToBounds="True"
              Background="{StaticResource HeaderGradient}"
              Padding="20,22,12,22" ColumnDefinitions="*,Auto">

            <Border x:Name="CircleLarge" WidthRequest="220" HeightRequest="220" StrokeThickness="0"
                    StrokeShape="Ellipse" BackgroundColor="#12FFFFFF" Grid.ColumnSpan="2"
                    HorizontalOptions="End" VerticalOptions="Start" Margin="0,-110,-70,0" InputTransparent="True" />
            <Border x:Name="CircleSmall" WidthRequest="120" HeightRequest="120" StrokeThickness="0"
                    StrokeShape="Ellipse" BackgroundColor="#0DFFFFFF" Grid.ColumnSpan="2"
                    HorizontalOptions="End" VerticalOptions="End" Margin="0,0,110,-70" InputTransparent="True" />

            <VerticalStackLayout Spacing="0">
                <Label Text="People" TextColor="White" FontFamily="OpenSansSemibold" FontSize="32" />
                <Label Text="{Binding SummaryText}" TextColor="#CCFFFFFF" FontSize="14" />
            </VerticalStackLayout>

            <Button Grid.Column="1" Text="Refresh" VerticalOptions="Start"
                    Style="{StaticResource BarButton}" Command="{Binding LoadCommand}" />
        </Grid>

        <SearchBar Grid.Row="1" Margin="12,8,12,0"
                   Placeholder="Search name, company, or city"
                   Text="{Binding SearchText}"
                   BackgroundColor="Transparent" />

        <!-- Error state: says what happened and offers the fix -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Margin="20,4,20,0" IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource DangerLabel}" VerticalOptions="Center" />
            <Button Text="Try again" Style="{StaticResource TextButton}" Command="{Binding LoadCommand}" />
        </HorizontalStackLayout>

        <!-- The list: grouped by first letter, wrapped in pull-to-refresh -->
        <RefreshView Grid.Row="3" Margin="20,0" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:UserGroup">
                        <Label Text="{Binding Key}" Padding="0,18,0,4"
                               FontFamily="OpenSansSemibold" FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <!-- Inside the template the binding source is one UserItem -->
                    <DataTemplate x:DataType="vm:UserItem">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14" Padding="0,10,0,0">

                            <!-- Tap anywhere on the row: the handler in code-behind runs the ViewModel's
                                 SelectUserCommand with this row's item. (Not a RelativeSource binding: a row is
                                 created before it is attached to the page, so climbing to the page's ViewModel can
                                 find nothing and crash.) -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" />
                            </Grid.GestureRecognizers>

                            <!-- Initials tile in the person's color -->
                            <Border Grid.Row="0" Grid.RowSpan="3" WidthRequest="48" HeightRequest="48"
                                    VerticalOptions="Center" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{Binding AvatarColor}">
                                <Label Text="{Binding Initials}" TextColor="White"
                                       FontFamily="OpenSansSemibold" FontSize="17"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding User.Name}" Style="{StaticResource NameLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding User.CompanyName}" Style="{StaticResource BodyLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding User.Email}" Style="{StaticResource MutedLabel}" />

                            <!-- Star: the handler in code-behind bounces it and runs the ViewModel's ToggleFavoriteCommand -->
                            <Label Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                                   Text="{Binding StarGlyph}" FontSize="26" Padding="10"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStarTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                            <BoxView Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource Divider}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Shown when there are no rows: loading, no matches, or no favorites -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,48,0,0" Spacing="6" HorizontalOptions="Center">
                        <Label Text="{Binding EmptyTitle}" Style="{StaticResource NameLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding EmptyHint}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- FOOTER: tab bar. A translucent pill slides under whichever tab is active
             (moved by the code-behind when ShowFavoritesOnly changes). -->
        <Grid x:Name="FooterBar" Grid.Row="4" ColumnDefinitions="*,*" HeightRequest="64"
              Background="{StaticResource FooterGradient}">

            <Border x:Name="TabPill" Grid.Column="0" Margin="14,10" InputTransparent="True"
                    StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="#2EFFFFFF" />

            <Label Grid.Column="0" Text="People" TextColor="White" FontSize="15"
                   HorizontalOptions="Center" VerticalOptions="Center" FontFamily="OpenSansSemibold">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ShowFavoritesOnly}" Value="True">
                        <Setter Property="Opacity" Value="0.8" />
                        <Setter Property="FontFamily" Value="OpenSansRegular" />
                    </DataTrigger>
                </Label.Triggers>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowAllCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1" Text="{Binding FavoritesLabel}" TextColor="White" FontSize="15"
                   Opacity="0.8" FontFamily="OpenSansRegular"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ShowFavoritesOnly}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="FontFamily" Value="OpenSansSemibold" />
                    </DataTrigger>
                </Label.Triggers>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowFavoritesCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Grid>
</ContentPage>
